{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "types": [
      "react-native",
      "jest"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "example",
    "lib"
  ]
}
