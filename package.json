{
  "name": "react-native-viewport-detector",
  "version": "2.0.0-beta.1",
  "description": "Detect when a view enters the viewport in React Native — works in ScrollView, FlatList, FlashList and nested horizontal lists. Event-driven, zero idle cost, Expo Go ready.",
  "source": "src/index.ts",
  "main": "lib/module/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "types": "./lib/typescript/jest/index.d.ts",
      "react-native": "./src/jest/index.ts",
      "default": "./lib/module/jest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinhkhang97/react-native-viewport-detector.git"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepack": "bob build"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "5.6"
  },
  "keywords": [
    "react-native",
    "intersection-observer",
    "in-view",
    "inview",
    "viewport",
    "visibility",
    "viewability",
    "impression",
    "lazy-load",
    "scrollview",
    "flatlist",
    "flashlist",
    "expo",
    "fabric"
  ],
  "author": "Khang Nguyen <thinhkhang97@gmail.com> (https://github.com/thinhkhang97)",
  "license": "ISC",
  "homepage": "https://github.com/thinhkhang97/react-native-viewport-detector#readme"
}
